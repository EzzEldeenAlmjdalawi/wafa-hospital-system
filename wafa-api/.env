DB_CONNECTION=sqlite
DB_DATABASE=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FRONTEND_URL=http://localhost:5173

# Civil Registry: replace only these three placeholders in wafa-api/.env.
CIVIL_REGISTRY_TOKEN_URL='https://ssoidp.gov.ps/sso/module.php/sspoauth2/token.php'
CIVIL_REGISTRY_CITIZEN_ID_URL='https://ws.gov.ps/citizen/id/'
CIVIL_REGISTRY_CLIENT_SECRET='_22a1e52c865881d81a376da679bb2c3b55f403f29e'

# Confirmed integration values.
CIVIL_REGISTRY_CLIENT_ID="MAIN_WAFFA_HOSPITAL"
CIVIL_REGISTRY_TOKEN_KEY=access_token
CIVIL_REGISTRY_AUTH_HEADER=x-sso-authorization
CIVIL_REGISTRY_USER_IP="931684898"
CIVIL_REGISTRY_USER_AGENT=

# Leave empty unless the provider explicitly requires a fresh session cookie.
CIVIL_REGISTRY_COOKIE='PHPSESSID=bdefdabba3d65586778ed0eb3536a13a'

# TLS must remain enabled. Optionally set an absolute cacert.pem path.
CIVIL_REGISTRY_VERIFY_SSL=true
CIVIL_REGISTRY_CA_BUNDLE=
CIVIL_REGISTRY_TIMEOUT=20
CIVIL_REGISTRY_CONNECT_TIMEOUT=8

# Official connector is active after the three required values are filled.
CIVIL_REGISTRY_MOCK=false

# Confirmed official response mapping.
CIVIL_REGISTRY_STATUS_PATH=status
CIVIL_REGISTRY_SUCCESS_VALUE=success
CIVIL_REGISTRY_DATA_PATH=data.basic
CIVIL_REGISTRY_FULL_NAME_KEY=FULLNAME
CIVIL_REGISTRY_DOB_KEY=BIRTH_DT
CIVIL_REGISTRY_GENDER_KEY=SEX_CD
CIVIL_REGISTRY_CITY_KEY=CI_REGION
CIVIL_REGISTRY_AREA_KEY=STREET_ARB
